# Firebase configuration
# Copy this file to .env and fill in your Firebase project values.
# Find these in the Firebase console: Project Settings > Your apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_DATABASE_URL=your_firebase_database_url

# Agora configuration
# Find this in the Agora console: https://console.agora.io
# Set token security to "Testing mode" (no token) for local development

VITE_AGORA_APP_ID=your_agora_app_id_here
